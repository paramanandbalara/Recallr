# Recallr server settings. Copy to .env for local development; in production set them in your host.

# MySQL: local now, Amazon RDS later (e.g. mysql://user:pass@your-db.xxxx.ap-south-1.rds.amazonaws.com:3306/recallr)
DATABASE_URL="mysql://recallr:password@127.0.0.1:3306/recallr"
# Only for `npm run db:migrate` in development (an empty database Prisma can use for checks)
SHADOW_DATABASE_URL="mysql://recallr:password@127.0.0.1:3306/recallr_shadow"

# "production" on the live server (stricter CORS); the Docker image sets it
NODE_ENV=development
PORT=4000
# A long random secret for sign-in tokens: generate one with `openssl rand -hex 32`
JWT_SECRET=
# Encrypts the API keys saved in Admin → Settings. Generate once (openssl rand -hex 32) and never change it.
ENCRYPTION_KEY=
# The website's address (comma-separated if more than one)
WEB_ORIGIN=http://localhost:5174
# The public address used in links, the sitemap and emails (defaults to the first WEB_ORIGIN)
# PUBLIC_URL=https://recallr.app
# The first account registered with this email becomes the admin
ADMIN_EMAIL=you@example.com

# Optional starting values: AI keys, Razorpay and payment details are set in Admin → Settings
# (saved in the database, encrypted). A value saved there wins over these.
GROQ_API_KEY=
OPENAI_API_KEY=
# Claude: answers chat (live answers use Claude Haiku 5.5, the fastest). Listening still needs Groq or OpenAI.
ANTHROPIC_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OFFLINE_PAYMENT_INFO="UPI: yourname@okbank · After paying, enter the UPI reference on the website."

# Optional: serve the built website (web/dist) from this server too, for a one-server setup
WEB_DIST=
